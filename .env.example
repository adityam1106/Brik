# Paste this into a .env file at the project root for local development
# On Vercel, set these as Environment Variables in the dashboard

# URL of your deployed backend (Railway)
# Leave empty to use mock data
VITE_API_URL=https://your-backend.railway.app

# Direct API keys (only needed if NOT using the backend)
VITE_FINNHUB_KEY=
VITE_PERIGON_KEY=
